---
interface Props {
  text?: string;
}

const defaultText =
  'Dit is algemene informatie, geen persoonlijk financieel of fiscaal advies. Jouw situatie kan afwijken. Twijfel je? Raadpleeg een erkend adviseur.';
const { text = defaultText } = Astro.props;
---

<aside class="disclaimer" aria-label="Disclaimer">
  <p><strong>Disclaimer:</strong> {text}</p>
</aside>

<style>
  .disclaimer {
    margin-top: 40px;
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  p { margin: 0; }
</style>

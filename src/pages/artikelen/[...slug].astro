---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { getArticles } from '../../utils/articles';
import { url, formatDate } from '../../utils/url';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { title, description, pubDate, updatedDate, category, disclaimer, calculator } = article.data;
const { Content } = await render(article);
---

<BaseLayout title={title} description={description}>
  <article class="prose">
    <a href={url('artikelen/')}>← Alle artikelen</a>
    <h1>{title}</h1>
    <p class="muted">
      {category} · <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <> · bijgewerkt {formatDate(updatedDate)}</>}
    </p>
    {calculator && <a class="naar-calculator" href="#calculator">{calculator} <span aria-hidden="true">↓</span></a>}
    <Content />
    <Disclaimer text={disclaimer} />
  </article>
</BaseLayout>

<style>
  .prose { max-width: 70ch; padding-top: 32px; }
  .naar-calculator {
    display: inline-block;
    margin: 4px 0 8px;
    padding: 10px 18px;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-bg);
    font-weight: 600;
    text-decoration: none;
  }
  .naar-calculator:hover { filter: brightness(1.1); }
  .naar-calculator:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .prose :global(blockquote) {
    margin: 24px 0;
    padding: 12px 16px;
    border-left: 4px solid var(--color-primary);
    background: var(--color-surface);
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 16px 0;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    white-space: nowrap;
  }
</style>

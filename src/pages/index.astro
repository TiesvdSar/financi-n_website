---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../utils/articles';
import { url } from '../utils/url';

const latest = (await getArticles()).slice(0, 3);
---

<BaseLayout title="Financiën">
  <section class="hero">
    <h1>Grip op je geld</h1>
    <p class="muted">Heldere uitleg over budgetteren, sparen, beleggen en belastingen.</p>
    <a class="button" href={url('artikelen/')}>Bekijk alle artikelen</a>
  </section>

  <section>
    <h2>Nieuwste artikelen</h2>
    <div class="grid">
      {latest.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 64px 0 32px; }
  .hero h1 { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 8px; }
  .button {
    display: inline-block;
    margin-top: 16px;
    padding: 10px 18px;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-bg);
    text-decoration: none;
    font-weight: 600;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
</style>
